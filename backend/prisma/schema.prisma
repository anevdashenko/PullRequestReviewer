generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Repository {
  id                   String              @id @default(cuid())
  provider             String              @default("github")
  owner                String
  name                 String
  webhookSecret        String
  accessToken          String
  prReviewEnabled      Boolean             @default(true)
  commitReviewEnabled  Boolean             @default(false)
  createdAt            DateTime            @default(now())
  rules                ReviewRule?
  reviewLogs           ReviewLog[]
  commitBatchReviews   CommitBatchReview[]
  reviewedCommits      ReviewedCommit[]

  @@unique([provider, owner, name])
}

model ReviewRule {
  id           String     @id @default(cuid())
  repoId       String     @unique
  repository   Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  systemPrompt String     @db.Text
  excludeGlobs Json       @default("[]")
  model        String     @default("gpt-4o-mini")
}

model ReviewLog {
  id           String     @id @default(cuid())
  repoId       String
  repository   Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  prNumber     Int
  commitSha    String?
  status       String
  errorMessage String?    @db.Text
  rawAiOutput  String?    @db.Text
  createdAt    DateTime   @default(now())
  finishedAt   DateTime?

  @@index([repoId, createdAt])
}

model CommitBatchReview {
  id              String           @id @default(cuid())
  repoId          String
  repository      Repository       @relation(fields: [repoId], references: [id], onDelete: Cascade)
  branchName      String
  authorLogin     String
  authorEmail     String?
  periodStart     DateTime
  periodEnd       DateTime
  commitShas      Json
  status          String
  seenByUser      Boolean          @default(false)
  mdContent       String?          @db.Text
  rawAiOutput     String?          @db.Text
  errorMessage    String?          @db.Text
  createdAt       DateTime         @default(now())
  finishedAt      DateTime?
  reviewedCommits ReviewedCommit[]

  @@index([repoId, createdAt])
  @@index([repoId, branchName, createdAt])
}

model ReviewedCommit {
  id                  String             @id @default(cuid())
  repoId              String
  repository          Repository         @relation(fields: [repoId], references: [id], onDelete: Cascade)
  branchName          String
  sha                 String
  commitBatchReviewId String?
  commitBatchReview   CommitBatchReview? @relation(fields: [commitBatchReviewId], references: [id], onDelete: SetNull)
  reviewedAt          DateTime           @default(now())

  @@unique([repoId, sha, branchName])
  @@index([repoId])
  @@index([repoId, branchName])
}
