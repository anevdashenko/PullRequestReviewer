# Copy to .env and adjust. Never commit .env.
# See Docs/WEBHOOK.md for GitHub/GitLab webhooks + ngrok.

# API listen port (backend + docker compose host mapping). Default 3000.
PORT=3000

# Vite dev server port (frontend). Default 3001 (5173 is often blocked on Windows).
FRONTEND_DEV_PORT=3001

# Host ports for Docker postgres/redis (must match docker-compose mapping).
# Defaults avoid Windows Hyper-V reserved ranges that block 5432 and 6379.
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379

# For backend on the host (npm run dev). In Docker, api/worker use service names instead.
DATABASE_URL=postgresql://prr:prr@localhost:15432/prr?schema=public&connect_timeout=10
REDIS_URL=redis://localhost:16379

# Single key for admin API + SPA (header X-Admin-Key)
ADMIN_API_KEY=change-me-to-a-long-random-string

# LLM provider for worker: openai (default) | qwen-cli
# LLM_PROVIDER=openai

# OpenAI (required when LLM_PROVIDER=openai, or as API key for qwen-cli settings)
OPENAI_API_KEY=

# Local OpenAI-compatible server (LM Studio, vLLM, etc.)
# OPENAI_BASE_URL=http://host.docker.internal:1234/v1

# response_format json_object (OpenAI only). Auto-off when OPENAI_BASE_URL is set.
# OPENAI_JSON_OBJECT_MODE=false

# Default LLM model for new repositories (optional)
# DEFAULT_LLM_MODEL=qwen2.5-coder-7b-instruct

# Max characters of .cs diff text sent to the LLM per review (default 120000)
# DIFF_MAX_CHARS=120000

# Include full .cs file at HEAD when patch is missing or short (default off)
# INCLUDE_FULL_FILE_CONTENT=true
# PATCH_MIN_CHARS=500
# FILE_MAX_CHARS=20000

# Public URL of your API for webhook setup hints (must match PORT if you change it)
PUBLIC_API_URL=http://localhost:3000

# Poll open PRs/MRs (GitHub + GitLab) on interval (ms). 0 = disabled. Example: 300000 = every 5 min.
# PR_POLL_INTERVAL_MS=300000

# Poll commits for batch review (ms). 0 = disabled. Independent from PR_POLL_INTERVAL_MS.
# COMMIT_POLL_INTERVAL_MS=3600000

# Lookback window for commit batch review (seconds from poll tick). Example: 86400 = 24 hours.
# COMMIT_REVIEW_LOOKBACK_SEC=86400

# Log level for poll/worker pino loggers: trace | debug | info | warn | error
# LOG_LEVEL=info

# Qwen CLI agent (when LLM_PROVIDER=qwen-cli). See Docs/QWEN_CLI.md
# QWEN_SETTINGS_FILE=./config/qwen/settings.json
# QWEN_CLI_TIMEOUT_MS=600000
# QWEN_CLI_EXTRA_ARGS=[]

# Git repo cache for qwen-cli workspace reviews (not deleted between jobs)
# REPO_CACHE_ROOT=/var/cache/prr/repos
# REPO_CACHE_GIT_TIMEOUT_MS=300000
# REPO_CACHE_FETCH_DEPTH=0

# Qwen CLI logging: stream lines to worker logs (default on). Set false to disable.
# QWEN_CLI_LOG_STREAM=true
# Store full prompt text in qwenCliLog (DB). Increases log size; default off.
# QWEN_CLI_LOG_INCLUDE_PROMPT=true
# Max chars stored in DB per review (default 500000)
# QWEN_CLI_LOG_MAX_CHARS=500000
# Optional directory for per-phase .log files (default: REPO_CACHE_ROOT/qwen-logs)
# QWEN_CLI_LOG_DIR=
