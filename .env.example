# Copy to .env and adjust. Never commit .env.
# See Docs/WEBHOOK.md for GitHub webhook + ngrok.

DATABASE_URL=postgresql://prr:prr@localhost:5432/prr?schema=public&connect_timeout=10
REDIS_URL=redis://localhost:6379

# Single key for admin API + SPA (header X-Admin-Key)
ADMIN_API_KEY=change-me-to-a-long-random-string

# OpenAI (required for worker)
OPENAI_API_KEY=

# Local OpenAI-compatible server (LM Studio, vLLM, etc.)
# OPENAI_BASE_URL=http://host.docker.internal:1234/v1

# response_format json_object (OpenAI only). Auto-off when OPENAI_BASE_URL is set.
# OPENAI_JSON_OBJECT_MODE=false

# Default LLM model for new repositories (optional)
# DEFAULT_LLM_MODEL=qwen2.5-coder-7b-instruct

# Public URL of your API for webhook setup hints (optional)
PUBLIC_API_URL=http://localhost:3000

# Poll open GitHub PRs on interval (ms). 0 = disabled. Example: 300000 = every 5 min (logs in api container).
# PR_POLL_INTERVAL_MS=300000

# Log level for poll/worker pino loggers: trace | debug | info | warn | error
# LOG_LEVEL=info
