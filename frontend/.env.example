# Public base URL of the backend (webhook hint in UI). Keep in sync with PORT in project root .env.
VITE_PUBLIC_API_URL=http://localhost:3000

# Dev server port is FRONTEND_DEV_PORT in root .env (vite.config.ts reads it there).

# When true, browser console shows [PRR API] request/response logs (also on by default in `npm run dev`).
# VITE_DEBUG_API=true
